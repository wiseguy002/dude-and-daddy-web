# Security headers on every page and file (worker/index.mjs sets the same ones on its /api/ answers).
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  # (no-transform stops Cloudflare adding its analytics beacon or rewriting email links)
  Cache-Control: public, max-age=0, must-revalidate, no-transform

# Versioned files (?v= in the link: bump it whenever the file changes)
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/press/*.png
  ! Cache-Control
  Cache-Control: public, max-age=86400

/press/*.gif
  ! Cache-Control
  Cache-Control: public, max-age=86400

/press/*.zip
  ! Cache-Control
  Cache-Control: public, max-age=86400

/og-studio.png
  ! Cache-Control
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  ! Cache-Control
  Cache-Control: public, max-age=86400

/favicon.*
  ! Cache-Control
  Cache-Control: public, max-age=86400
