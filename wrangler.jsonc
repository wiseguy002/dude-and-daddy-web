{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio",
  "main": "worker/index.mjs",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // (only the news list's three addresses run code: every page is still a plain file)
    "run_worker_first": ["/api/*"]
  },
  // the news list: confirmed subscribers (`sub:<email>`) and the day's counts
  "kv_namespaces": [{ "binding": "SIGNUP", "id": "5bd1a7897b8144f495a415879c82e61a" }],
  // sign-ups from one address: 5 a minute
  "ratelimits": [{ "name": "SIGNUPS", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } }],
  // (RESEND_API_KEY, EMAIL_FROM and SIGNUP_SECRET are secrets set in the dashboard, never in this repo)
  // the Resend segment confirmed subscribers are copied to (previews leave it out: they never touch the real list)
  "vars": { "NEWS_SEGMENT_ID": "8d56340a-7b0b-46d6-9e26-37f53c9916dd" },
  "observability": { "enabled": true },
  // pull-request previews (Cloudflare builds one per branch): their own empty list, never the real subscribers.
  // A preview has no mail secrets, so its form answers "the mail room is closed".
  "previews": {
    "kv_namespaces": [{ "binding": "SIGNUP", "id": "fdcd54f74e9f453f81414647fb2b2f99" }],
    "ratelimits": [{ "name": "SIGNUPS", "namespace_id": "2002", "simple": { "limit": 5, "period": 60 } }]
  }
}
